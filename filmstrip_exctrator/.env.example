# Environment configuration for Filmstrip Extractor
# Copy this file to .env and update the paths according to your system

# Path to oiiotool executable (required for image sequence processing)
# Examples:
# Windows: OIIOTOOL_PATH=C:\Program Files\OpenImageIO\bin\oiiotool.exe
# Linux/Mac: OIIOTOOL_PATH=/usr/local/bin/oiiotool
OIIOTOOL_PATH=oiiotool

# Path to ffmpeg executable (optional, if not in system PATH)
# Examples:
# Windows: FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# Linux/Mac: FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFMPEG_PATH=ffmpeg

# Default temporary directory for intermediate files (optional)
# If not set, system temporary directory will be used
# TEMP_DIR=/tmp/filmstrip_temp

# Logging level (optional)
# Options: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# Default output quality for JPG images (optional)
# Range: 1-100 (higher = better quality, larger file size)
# JPG_QUALITY=85

# Maximum number of frames to process (optional)
# Useful for very long videos to prevent excessive processing
# MAX_FRAMES=1000
